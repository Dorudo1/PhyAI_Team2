Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: base_link
    Background Color: 30; 30; 30
    Frame Rate: 15
  Displays:
    - Class: rviz_default_plugins/MarkerArray
      Name: Discovery workspace
      Enabled: true
      Marker Topic:
        Value: /junh/workspace_markers
    - Class: rviz_default_plugins/Image
      Name: Overhead detections
      Enabled: true
      Topic:
        Value: /junh/overhead/overlay
    - Class: rviz_default_plugins/Image
      Name: Wrist detections
      Enabled: true
      Topic:
        Value: /junh/wrist/overlay
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.5
      Focal Point:
        X: 0.3
        Y: 0.0
        Z: 0.0
      Pitch: 1.2
      Yaw: 0.0
